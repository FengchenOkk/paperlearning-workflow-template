    {
      "id": "b-transistor-result",
      "type": "RESULT",
      "page": 1,
      "section": "Abstract",
      "components": [
        {
          "original_block": 7,
          "bbox": [
            217.32009887695312,
            218.87550354003906,
            560.9495239257812,
            502.9736328125
          ],
          "text": "Owing to improved contacts, short-channel molybdenum \ndisulfide transistors show current saturation under one-volt drain bias with an \non-state current of 1.23 milliamperes per micrometre, an on/off ratio over 108 and  \nan intrinsic delay of 74 femtoseconds."
        }
      ],
      "number": null,
      "quantities": [
        {
          "value": "1.23",
          "unit": "milliamperes per micrometre",
          "context": "on-state current"
        },
        {
          "value": "10^8",
          "unit": "dimensionless",
          "context": "on/off ratio lower bound",
          "representation_warning": "PDF text collapses exponent to 108; plain source quote is ambiguous"
        },
        {
          "value": "74",
          "unit": "femtoseconds",
          "context": "intrinsic delay"
        }
      ],
      "epistemic_status": "AUTHOR_CLAIM",
      "review_origin": "MODEL_SOURCE_REVIEW",
      "human_review": "PENDING",
      "channel": "PAPER_TEXT_EXPLICIT",
      "visual_inferences": []
    },
    {
