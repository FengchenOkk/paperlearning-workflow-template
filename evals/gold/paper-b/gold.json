    {
      "id": "b-contact-method",
      "type": "METHOD",
      "page": 1,
      "section": "Abstract",
      "components": [
        {
          "original_block": 7,
          "bbox": [
            217.32009887695312,
            218.87550354003906,
            560.9495239257812,
            502.9736328125
          ],
          "text": "Here we push the electrical contact of monolayer molybdenum \ndisulfide close to the quantum limit by hybridization of energy bands with semi- \nmetallic antimony (0112) through strong van der Waals interactions."
        }
      ],
      "number": null,
      "quantities": [],
      "epistemic_status": "AUTHOR_CLAIM",
      "review_origin": "MODEL_SOURCE_REVIEW",
      "human_review": "PENDING",
      "channel": "PAPER_TEXT_EXPLICIT",
